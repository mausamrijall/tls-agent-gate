{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mausamrijall/tls-agent-gate/blob/main/packages/core/src/schemas/agent-manifest.schema.json",
  "title": "Agent Manifest",
  "description": "Open Agentic Web agent capability manifest served at https://<domain>/agent-manifest.json",
  "type": "object",
  "required": ["schemaVersion", "name", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": "agent-manifest-v1"
    },
    "agent": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "format": "uri"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/capability"
      }
    },
    "trust": {
      "type": "object",
      "properties": {
        "allowLocalAgents": {
          "type": "boolean"
        },
        "allowedDevKeyThumbprints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requireSignedRequests": {
          "type": "boolean"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        }
      }
    }
  }
}
